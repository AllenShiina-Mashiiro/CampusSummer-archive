# ===========================================================================
# CampusSummer Archive / 学园夏日局
# 复制为 .env 后按需修改：
#   PowerShell: Copy-Item .env.example .env
#   bash:       cp .env.example .env
#
# .env 已被 .gitignore 忽略。不要提交任何真实密钥、邮箱授权码或数据库密码。
# ===========================================================================

# ----------------------------- 数据库（必填） -----------------------------
# 本地开发：npm run db:up 会在 127.0.0.1:5432 启动工作区内的独立实例
# 接入现有 PostgreSQL 时替换成真实连接串
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/campussummer?schema=public"

# ------------------------------ 站点（公开） ------------------------------
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_SITE_NAME="学园夏日局"
# 页脚版权年份，可选
NEXT_PUBLIC_SITE_YEAR="2026"

# --------------------------- 会话签名（必填） -----------------------------
# 生产环境务必替换成随机值：openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"

# ---------------------------- 注册开关（可选） ----------------------------
# 设为 "false" 可关闭公开注册；不填默认开启
REGISTRATION_ENABLED="true"

# ----------------------------- Redis（可选） ------------------------------
# 留空则自动降级为进程内缓存
REDIS_URL=""

# -------------------------- S3 / 对象存储（可选） -------------------------
# 留空则图片写入本地 public/uploads
S3_REGION=""
S3_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ------------------------------ SMTP（注册必填） --------------------------
# 注册必须发送邮箱验证码；SMTP_PASS 填「授权码」，不是登录密码
# 163: smtp.163.com / 465(SSL)
# QQ:  smtp.qq.com / 465
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="学园夏日局 <your@163.com>"

# ------------------------- 管理员邮箱（本地测试） -------------------------
# 必须与 SMTP_USER 填同一个邮箱。
# 种子会把 allen 的邮箱、站点设置里的「管理员邮箱」都设为这个值。
ADMIN_EMAIL=""

# --------------------------- 种子脚本（可选） -----------------------------
# 演示账号密码，默认 campus2026；仅本地开发使用
SEED_PASSWORD="campus2026"

# ---------------------- 生产初始化管理员（仅 CLI 读取） -------------------
# 不写入仓库；运行时通过 shell 环境变量传入：
#   ADMIN_USERNAME="admin"
#   ADMIN_EMAIL="you@example.com"
#   ADMIN_PASSWORD="至少10位且含字母数字"
#   ADMIN_DISPLAY_NAME="站长"
