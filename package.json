{
  "name": "campussummer-archive",
  "version": "0.1.0",
  "private": true,
  "description": "CampusSummer Archive / 学园夏日局 —— 游戏文化档案与资料整理站",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "powershell -ExecutionPolicy Bypass -File scripts/dev-db.ps1 start",
    "db:down": "powershell -ExecutionPolicy Bypass -File scripts/dev-db.ps1 stop",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:reset": "node prisma/seed.mjs --reset",
    "db:reset-content": "node scripts/reset-content.mjs",
    "db:create-admin": "node scripts/create-admin.mjs",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "ioredis": "^6.0.0",
    "jose": "6.2.17",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "prisma": "6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
